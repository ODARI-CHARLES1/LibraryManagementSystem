{
  "info": {
    "name": "Library Management System - Complete API Collection",
    "description": "Comprehensive Postman collection for all LMS API endpoints including Books, Categories, Users, Comments, and Borrow Records.\n\n**Authentication**: Most endpoints require Bearer token authentication\n- Public endpoints: No auth required\n- User endpoints: Any authenticated user\n- Admin endpoints: Require 'admin' role\n\n**Base URL**: {{baseUrl}}\n\n**Variables**:\n- `baseUrl`: Base API URL (e.g., http://localhost:3000)\n- `authToken`: Regular user authentication token\n- `adminToken`: Admin user authentication token\n- `lastCreatedBookId`: Stores ID of last created book\n- `lastCreatedCategoryId`: Stores ID of last created category",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "Authentication",
      "description": "User authentication endpoints",
      "item": [
        {
          "name": "User Login",
          "description": "Authenticate user and get JWT token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": ["{{baseUrl}}"],
              "path": ["users", "login"]
            },
            "description": "Returns JWT token for authenticated user. Use this token for other authenticated endpoints."
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/users/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["users", "login"]
                }
              },
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...\",\n  \"user\": {\n    \"user_id\": 1,\n    \"username\": \"admin\",\n    \"email\": \"admin@example.com\",\n    \"role\": \"Admin\"\n  }\n}",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            },
            {
              "name": "Invalid Credentials",
              "originalRequest": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/users/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["users", "login"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"success\": false,\n  \"message\": \"Invalid email or password\"\n}",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ]
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response has token\", function () {",
                  "    pm.expect(pm.response.json().token).to.exist;",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('authToken', pm.response.json().token);",
                  "    pm.test(\"Token stored for future requests\", function () {",
                  "        pm.expect(pm.collectionVariables.get('authToken')).to.not.be.empty;",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
