{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "rootDir": "./",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
, "index.ts"  ],
  "exclude": [
    "node_modules",
    "**/*.spec.ts"
  ]
}